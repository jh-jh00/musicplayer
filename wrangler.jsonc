{
  "name": "musicplayer",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/watch",
      "/watch/"
    ]
  },
  "d1_databases": [
    {
      "binding": "youtube_player_db",
      "database_name": "playlist-player-db",
      "database_id": "1a0e83d3-3fd5-4c07-929f-b99e70a7c24b"
    }
  ],
  "ratelimits": [
    {
      "name": "PLAYER_SEARCH_LIMITER",
      "namespace_id": "16601",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
